# Banco usado pelo Prisma CLI (migrations/seed) e pela API em desenvolvimento.
DATABASE_URL="postgresql://epi_manager:epi_manager@localhost:5432/epi_manager?schema=public"

# Banco DESCARTAVEL para os testes de integracao da API (as tabelas sao truncadas).
TEST_DATABASE_URL="postgresql://epi_manager:epi_manager@localhost:5432/epi_manager_test?schema=public"

# Senhas iniciais criadas pelo seed de desenvolvimento (minimo 10 caracteres).
# O ADMIN e obrigado a trocar a senha no primeiro acesso. O seed recusa rodar com NODE_ENV=production.
SEED_ADMIN_PASSWORD="Admin@Engenova1"
SEED_ALMOX_PASSWORD="Almox@Engenova1"
