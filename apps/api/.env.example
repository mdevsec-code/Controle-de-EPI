NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://epi_manager:epi_manager@localhost:5432/epi_manager?schema=public"

# Segredo do JWT: minimo 32 caracteres aleatorios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Valores iniciados por "troque-" sao recusados em producao.
JWT_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# Quantos proxies reversos confiaveis ficam a frente da API (0 = acesso direto).
# Necessario para o IP real no rate limit e na auditoria.
TRUST_PROXY=0

# Somente se web e API rodarem em origens diferentes sem proxy (o padrao e mesmo site via /api).
# CORS_ORIGIN="http://localhost:5173"
