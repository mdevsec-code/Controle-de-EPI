generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================================
// Usuarios (quem opera o sistema)
// ==========================================================================

enum UserRole {
  ADMIN
  ALMOXARIFADO
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               UserRole
  active             Boolean   @default(true)
  // Incrementado ao desativar o usuario, trocar perfil ou senha: invalida access tokens emitidos.
  tokenVersion       Int       @default(0) @map("token_version")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  warehouses      UserWarehouse[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  deliveriesMade  Delivery[]
  returnsReceived EpiReturn[]

  @@map("users")
}

model UserWarehouse {
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([warehouseId])
  @@map("user_warehouses")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================================================
// Empresas / Unidades / Setores / Cargos
// ==========================================================================

model Company {
  id               String   @id @default(uuid())
  name             String
  tradeName        String?  @map("trade_name")
  cnpj             String   @unique
  responsibleName  String?  @map("responsible_name")
  responsibleEmail String?  @map("responsible_email")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  businessUnits BusinessUnit[]

  @@map("companies")
}

model BusinessUnit {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  code      String
  street    String?
  number    String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments Department[]
  employees   Employee[]
  warehouses  Warehouse[]

  @@unique([companyId, code])
  @@map("business_units")
}

model Department {
  id             String       @id @default(uuid())
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  name           String
  code           String
  parentId       String?      @map("parent_id")
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  employees Employee[]

  @@unique([businessUnitId, code])
  @@map("departments")
}

model JobRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees    Employee[]
  requiredEpis JobRoleRequiredEpi[]

  @@map("job_roles")
}

model JobRoleRequiredEpi {
  id        String  @id @default(uuid())
  jobRoleId String  @map("job_role_id")
  jobRole   JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  epiItemId String  @map("epi_item_id")
  epiItem   EpiItem @relation(fields: [epiItemId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([jobRoleId, epiItemId])
  @@map("job_role_required_epis")
}

// ==========================================================================
// Colaboradores (pessoas que recebem EPI; nao fazem login nesta fase)
// ==========================================================================

enum EmployeeStatus {
  ATIVO
  INATIVO
  BLOQUEADO
  DESLIGADO
}

model Employee {
  id              String         @id @default(uuid())
  registration    String
  cpf             String         @unique
  name            String
  email           String?
  phone           String?
  photoUrl        String?        @map("photo_url")
  status          EmployeeStatus @default(ATIVO)
  // Conteudo do QR Code do cracha: valor aleatorio e opaco, reemitivel (nunca CPF/ID/matricula).
  badgeCode       String         @unique @map("badge_code")
  admissionDate   DateTime?      @map("admission_date")
  terminationDate DateTime?      @map("termination_date")
  costCenter      String?        @map("cost_center")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  businessUnitId String  @map("business_unit_id")
  departmentId   String  @map("department_id")
  jobRoleId      String  @map("job_role_id")
  supervisorId   String? @map("supervisor_id")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobRole      JobRole      @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  supervisor   Employee?    @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates Employee[]   @relation("EmployeeSupervisor")

  deliveries Delivery[]

  @@unique([businessUnitId, registration])
  @@index([name])
  @@index([registration])
  @@map("employees")
}

// ==========================================================================
// EPIs
// ==========================================================================

model EpiCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  epiItems EpiItem[]

  @@map("epi_categories")
}

model EpiItem {
  id             String      @id @default(uuid())
  name           String
  internalCode   String      @unique @map("internal_code")
  barcode        String?     @unique
  categoryId     String      @map("category_id")
  category       EpiCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer   String
  model          String?
  photoUrl       String?     @map("photo_url")
  manualUrl      String?     @map("manual_url")
  minQuantity    Int         @default(0) @map("min_quantity")
  unitPriceCents Int?        @map("unit_price_cents")
  usefulLifeDays Int?        @map("useful_life_days")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  cas                 EpiCA[]
  stockItems          StockItem[]
  deliveryItems       DeliveryItem[]
  jobRoleRequirements JobRoleRequiredEpi[]

  @@index([name])
  @@map("epi_items")
}

model EpiCA {
  id          String    @id @default(uuid())
  epiItemId   String    @map("epi_item_id")
  epiItem     EpiItem   @relation(fields: [epiItemId], references: [id], onDelete: Cascade)
  number      String
  issuedAt    DateTime  @map("issued_at")
  // Validade derivada de expiresAt; so o cancelamento e gravado.
  expiresAt   DateTime  @map("expires_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([epiItemId])
  @@map("epi_cas")
}

// ==========================================================================
// Estoque: saldo materializado (StockItem.quantity, CHECK >= 0 na migration)
// + razao de movimentacoes (StockMovement). Saldo so muda junto com movimento.
// ==========================================================================

enum StockMovementType {
  ENTRADA
  SAIDA
  ENTREGA
  DEVOLUCAO
  AJUSTE
  PERDA
  AVARIA
}

model Warehouse {
  id             String       @id @default(uuid())
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  name           String
  code           String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users      UserWarehouse[]
  stockItems StockItem[]
  deliveries Delivery[]

  @@unique([businessUnitId, code])
  @@map("warehouses")
}

model StockItem {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  epiItemId   String    @map("epi_item_id")
  epiItem     EpiItem   @relation(fields: [epiItemId], references: [id], onDelete: Restrict)
  // String vazia = EPI sem grade / sem lote (evita NULL em chave unica).
  size        String    @default("")
  batchNumber String    @default("") @map("batch_number")
  // Onde o item fica guardado no almoxarifado (ex.: "Corredor A · Prateleira 2"); vazio = nao definido.
  location    String    @default("")
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  movements     StockMovement[]
  deliveryItems DeliveryItem[]
  returns       EpiReturn[]

  @@unique([warehouseId, epiItemId, size, batchNumber])
  @@index([epiItemId])
  @@index([warehouseId, location])
  @@map("stock_items")
}

model StockMovement {
  id             String            @id @default(uuid())
  stockItemId    String            @map("stock_item_id")
  stockItem      StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  type           StockMovementType
  // Variacao assinada do saldo (entrada positiva, saida negativa).
  delta          Int
  balanceBefore  Int               @map("balance_before")
  balanceAfter   Int               @map("balance_after")
  reason         String?
  performedById  String            @map("performed_by_id")
  performedBy    User              @relation(fields: [performedById], references: [id], onDelete: Restrict)
  deliveryItemId String?           @map("delivery_item_id")
  deliveryItem   DeliveryItem?     @relation(fields: [deliveryItemId], references: [id], onDelete: Restrict)
  returnId       String?           @map("return_id")
  epiReturn      EpiReturn?        @relation(fields: [returnId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([stockItemId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

// ==========================================================================
// Entregas (operacao imutavel apos registrada) / Devolucoes
// ==========================================================================

enum DeliveryStatus {
  CONCLUIDA
  CANCELADA
}

enum DeliveryReason {
  DESGASTE
  DANO
  ROTINA
  ATIVIDADE_ESPECIAL
  PERDA
  EXTRAVIO
  NOVO_COLABORADOR
  OUTRO
}

model Delivery {
  id             String         @id @default(uuid())
  // Numero sequencial legivel para comprovante ("Entrega no 000123").
  number         Int            @unique @default(autoincrement())
  idempotencyKey String         @unique @map("idempotency_key")
  status         DeliveryStatus @default(CONCLUIDA)
  reason         DeliveryReason
  reasonDetail   String?        @map("reason_detail")
  notes          String?
  employeeId     String         @map("employee_id")
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  warehouseId    String         @map("warehouse_id")
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  deliveredById  String         @map("delivered_by_id")
  deliveredBy    User           @relation(fields: [deliveredById], references: [id], onDelete: Restrict)
  deliveredAt    DateTime       @default(now()) @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  items     DeliveryItem[]
  signature DeliverySignature?

  @@index([employeeId, deliveredAt])
  @@index([warehouseId, deliveredAt])
  @@index([deliveredAt])
  @@map("deliveries")
}

model DeliveryItem {
  id                    String    @id @default(uuid())
  deliveryId            String    @map("delivery_id")
  delivery              Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  epiItemId             String    @map("epi_item_id")
  epiItem               EpiItem   @relation(fields: [epiItemId], references: [id], onDelete: Restrict)
  stockItemId           String    @map("stock_item_id")
  stockItem             StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity              Int
  // Snapshots do momento da entrega (exigencia NR-6: CA vigente na entrega).
  epiName               String    @map("epi_name")
  caNumber              String    @map("ca_number")
  size                  String    @default("")
  batchNumber           String    @default("") @map("batch_number")
  notes                 String?
  expectedReplacementAt DateTime? @map("expected_replacement_at")

  movements StockMovement[]
  returns   EpiReturn[]

  @@index([deliveryId])
  @@map("delivery_items")
}

model DeliverySignature {
  deliveryId  String   @id @map("delivery_id")
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  image       Bytes
  imageType   String   @map("image_type")
  // SHA-256 do conteudo canonico da entrega + imagem: permite verificar integridade.
  contentHash String   @map("content_hash")
  signedAt    DateTime @map("signed_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  @@map("delivery_signatures")
}

enum ReturnCondition {
  BOM
  DANIFICADO
  DESCARTADO
}

model EpiReturn {
  id             String          @id @default(uuid())
  deliveryItemId String          @map("delivery_item_id")
  deliveryItem   DeliveryItem    @relation(fields: [deliveryItemId], references: [id], onDelete: Restrict)
  quantity       Int
  condition      ReturnCondition
  reason         String?
  // Preenchido quando o item volta ao estoque (condicao BOM).
  stockItemId    String?         @map("stock_item_id")
  stockItem      StockItem?      @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  receivedById   String          @map("received_by_id")
  receivedBy     User            @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  returnedAt     DateTime        @default(now()) @map("returned_at")

  movements StockMovement[]

  @@index([deliveryItemId])
  @@map("epi_returns")
}

// ==========================================================================
// Auditoria
// ==========================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
